# .env.example
# Environment configuration for Deer Detection system.
# Copy this file to .env and adjust values as needed.

HOST=0.0.0.0
PORT=8000

# Path to YOLO model (must exist)
MODEL_PATH=model/best.pt

# YOLO inference parameters
YOLO_CONFIDENCE=0.3
YOLO_IOU=0.5
YOLO_IMG_SIZE=640
YOLO_DEVICE=cuda

# Camera configuration (LOCAL_VIDEO, IP_CAMERA, etc.)
CAMERA_TYPE=LOCAL_VIDEO
CAMERA_SOURCE=videos/deer_test.mp4
CAMERA_TIMEOUT=10
CAMERA_RECONNECT_DELAY=5

# Road zone polygon – JSON list of [x, y] points. Leave empty if not known.
# Example: [[100,200],[400,200],[400,600],[100,600]]
ROAD_ZONE=""
ROAD_DISTANCE_THRESHOLD=20.0

# Speed thresholds (pixels per frame)
CAUTION_SPEED=2.0
HIGH_RISK_SPEED=5.0

# Prediction horizon (frames ahead)
PREDICTION_HORIZON=5

# Maximum number of historical points stored per track
MAX_HISTORY=30

# VLM (BLIP) settings
VLM_ENABLED=true
VLM_MODEL=Salesforce/blip-image-captioning-base
VLM_COOLDOWN=30
